    "deny": [
      "Bash(git push -f*)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.secrets)"
    ],
    "ask": [
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto"
  }
}
